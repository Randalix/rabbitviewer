# Copy to ~/.config/rabbitviewer/config.yaml (or $XDG_CONFIG_HOME/rabbitviewer/config.yaml)
cache_dir: ~/.rabbitviewer
files:
  cache:
    dir: ~/.rabbitviewer/cache
gui:
  background_color: '#000000'
  border_width: 1
  hover_border_color: '#2d59b6'
  placeholder_color: black
  select_border_color: orange
  spacing: 1
  statusbar_font: monospace
  info_panel_opacity: 0.5
  statusbar_font_size: 10
hotkeys:
  close_or_quit:
    description: Close picture view, then inspector views, then quit
    sequence: q
  escape_picture_view:
    description: Return to thumbnail view
    sequence: Esc
  next_image:
    description: Navigate to next image
    extra_sequences:
    - Right
    sequence: D
  open_filter:
    description: Open filter dialog
    sequence: Ctrl+F
  toggle_inspector:
    description: Toggle inspector window
    sequence: I
  previous_image:
    description: Navigate to previous image
    extra_sequences:
    - Left
    sequence: A
  script:delete_selected:
    description: Delete selected images
    extra_sequences:
    - Del
    sequence: Shift+R
  menu:rotate:
    description: Open rotate menu
    sequence: R
  script:invert_selection:
    description: Invert the current selection
    sequence: Shift+I
  script:select_all:
    description: Select all images
    sequence: Ctrl+A
  script:set_rating_0:
    description: Set rating to 0 stars
    sequence: '0'
  script:set_rating_1:
    description: Set rating to 1 star
    sequence: '1'
  script:set_rating_2:
    description: Set rating to 2 stars
    sequence: '2'
  script:set_rating_3:
    description: Set rating to 3 stars
    sequence: '3'
  script:set_rating_4:
    description: Set rating to 4 stars
    sequence: '4'
  script:set_rating_5:
    description: Set rating to 5 stars
    sequence: '5'
  script:sort_by_name:
    description: Sort images by filename
  menu:sort:
    description: Open sort menu
    sequence: F
  show_hotkey_help:
    description: Show keyboard shortcuts
    sequence: '?'
  zoom_in:
    description: Zoom in
    sequence: '+'
  zoom_out:
    description: Zoom out
    sequence: '-'
ignore_patterns:
- ._*
inspector:
  zoom_factor: 0.5
logging_level: INFO
# Per-module log level overrides (module names match Python package paths):
# logging_levels:
#   core.rendermanager: DEBUG
#   core.metadata_database: WARNING
#   gui.thumbnail_view: WARNING
#   plugins.cr3_plugin: DEBUG
min_file_size: 8192
system:
  socket_path: /tmp/rabbitviewer.sock
max_cache_size_mb: 10240  # 10 GB; 0 = unlimited
thumbnail_size: 128
watch_paths:
- ~/Pictures
